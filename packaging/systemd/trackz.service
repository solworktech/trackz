# systemd *user* unit. The deb and rpm packages install it to
# /usr/lib/systemd/user/ and enable it for every user. By hand:
#   install -Dm644 trackz.service ~/.config/systemd/user/trackz.service
#   systemctl --user daemon-reload && systemctl --user enable --now trackz
#
# trackz needs DISPLAY. Most desktop environments export it to the systemd
# user manager; if yours does not, add this to your session startup:
#   systemctl --user import-environment DISPLAY XAUTHORITY
[Unit]
Description=Trackz - record time spent in windows/applications
Documentation=https://github.com/solworktech/trackz
PartOf=graphical-session.target
After=graphical-session.target

[Service]
# Optional overrides, e.g. TRACKZ_DB=~/.config/trackz/trackz.db (trackz
# expands ~ and $VARS itself; systemd does not).
EnvironmentFile=-%h/.config/trackz/trackz.env
# No directory: systemd looks in /usr/local/bin, then /usr/bin, so the same
# unit serves `make install` and the packages.
ExecStart=trackz run
# Ends the open record and waits for trackz to exit (systemd's SIGTERM
# would too; this is the same request the Windows installer makes).
ExecStop=trackz stop
Restart=on-failure
RestartSec=5
# 3: another trackz already records to the database; retrying won't help.
RestartPreventExitStatus=3

[Install]
WantedBy=graphical-session.target
